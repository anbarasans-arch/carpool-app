EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key - server-side only. Never prefix with EXPO_PUBLIC_.
SUPABASE_SECRET_KEY=

# Resend API key, used as the SMTP password for `supabase config push`.
RESEND_SMTP_PASS=

# "From" address/name for OTP emails.
RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=

# Map tiles (MapTiler) and geocoding (LocationIQ).
EXPO_PUBLIC_MAPTILER_KEY=
EXPO_PUBLIC_LOCATIONIQ_KEY=

# PostHog product analytics (client-safe "project API key", meant to be
# public). Leave blank to disable analytics entirely - lib/analytics.ts
# no-ops without it. EXPO_PUBLIC_POSTHOG_HOST defaults to the US cloud if unset.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# Company work-email domain for sign-in restriction (e.g. "example.com").
# Not committed - deployed via `supabase secrets set ALLOWED_EMAIL_DOMAIN=...`.
ALLOWED_EMAIL_DOMAIN=
